<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MediQ | Smart Healthcare Appointment & Queue Management</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- ===================== NAVBAR ===================== -->

    <%- include('../partials/publicNavbar', { currentPage: 'home' }) %>

    <!-- ===================== HERO ===================== -->

    <section class="hero">

        <div class="bg-circle bg-circle-1"></div>
        <div class="bg-circle bg-circle-2"></div>

        <div class="container">

            <div class="row align-items-center">

                <!-- LEFT -->

                <div class="col-lg-6">

                    <span class="badge-health">
                        <i class="bi bi-check-circle-fill"></i>
                        Government Healthcare Service
                    </span>

                    <h1 class="hero-title mt-4">
                        Quality Care,
                        <span>Without the Wait.</span>
                    </h1>

                    <p class="hero-text">

                        Welcome to MediQ — Smart Healthcare Appointment & Queue Management

                        Book appointments online, receive your queue number,
                        and track your turn in real time from anywhere.

                    </p>

                    <div class="mt-4">

                        <a href="/register" class="btn btn-primary-custom">
                            Book Appointment
                            <i class="bi bi-arrow-right"></i>
                        </a>

                        <a href="/about" class="btn btn-outline-custom">
                            Learn More
                        </a>

                    </div>

                    <!-- Statistics (LIVE) -->

                    <div class="row mt-5 stats">

                        <div class="col-4">

                            <h2><%= stats.patientsServed %>+</h2>
                            <p>Patients Served</p>

                        </div>

                        <div class="col-4">

                            <h2><%= stats.totalDoctors %>+</h2>
                            <p>Doctors</p>

                        </div>

                        <div class="col-4">

                            <h2>24/7</h2>
                            <p>Online Booking</p>

                        </div>

                    </div>

                </div>

                <!-- RIGHT -->

                <div class="col-lg-6 text-center position-relative mt-5 mt-lg-0">

                    <!-- Live Queue Tracking Callout
                         (no fabricated number -- there's no single
                         hospital-wide "current queue"; each doctor
                         session has its own) -->

                    <div class="queue-card">

                        <div>

                            <small>Live Tracking</small>

                            <h3 style="font-size:20px;">Real-Time Queue</h3>

                        </div>

                        <i class="bi bi-clock-history"></i>

                    </div>

                    <!-- Main Illustration -->

                    <div class="hero-image">
                        <img src="/images/doctor.svg"
                            class="img-fluid"
                            alt="Doctor Illustration">
                    </div>

                    <!-- Appointment Card -->

                    <div class="appointment-card">

                        <i class="bi bi-check-circle-fill"></i>

                        <div>

                            <small>Appointment</small>

                            <h5>Book in Minutes</h5>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- ===================== FEATURES ===================== -->

    <section class="features">

        <div class="container">

            <div class="text-center mb-5">

                <h2>Why Choose MediQ?</h2>

                <p>
                    Designed to reduce waiting time and improve the patient experience.
                </p>

            </div>

            <div class="row g-4">

                <div class="col-lg-3 col-md-6">

                    <div class="feature-card">

                        <i class="bi bi-calendar-check"></i>

                        <h4>Easy Booking</h4>

                        <p>Book appointments anytime without visiting the hospital.</p>

                    </div>

                </div>

                <div class="col-lg-3 col-md-6">

                    <div class="feature-card">

                        <i class="bi bi-clock-history"></i>

                        <h4>Live Queue</h4>

                        <p>Track your queue number in real time.</p>

                    </div>

                </div>

                <div class="col-lg-3 col-md-6">

                    <div class="feature-card">

                        <i class="bi bi-bell"></i>

                        <h4>Notifications</h4>

                        <p>Receive reminders before your appointment.</p>

                    </div>

                </div>

                <div class="col-lg-3 col-md-6">

                    <div class="feature-card">

                        <i class="bi bi-heart-pulse"></i>

                        <h4>Quality Care</h4>

                        <p>Fast and efficient healthcare management.</p>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- ===================== DEPARTMENTS (LIVE) ===================== -->

    <section class="departments" id="departments">

        <div class="container">

            <div class="section-title text-center">

                <h2>Our Departments</h2>

                <p>
                    Explore our specialized medical departments providing
                    quality healthcare services.
                </p>

            </div>

            <% if (clinics.length === 0) { %>

                <p class="text-center" style="color:#64748b;">
                    Department information will be available soon.
                </p>

            <% } else { %>

                <div class="row g-4">

                    <% clinics.forEach(function(clinic) { %>

                        <%
                            const nameLower = clinic.clinic_name.toLowerCase();
                            let deptIcon = 'bi-hospital';

                            if (nameLower.includes('dental')) deptIcon = 'bi-emoji-smile';
                            else if (nameLower.includes('eye')) deptIcon = 'bi-eye';
                            else if (nameLower.includes('pediatric') || nameLower.includes('paediatric') || nameLower.includes('child')) deptIcon = 'bi-bandaid';
                            else if (nameLower.includes('cardio') || nameLower.includes('heart')) deptIcon = 'bi-heart-pulse';
                            else if (nameLower.includes('general') || nameLower.includes('medicine')) deptIcon = 'bi-heart-pulse';
                        %>

                        <div class="col-lg-3 col-md-6">

                            <div class="department-card">

                                <i class="bi <%= deptIcon %>"></i>

                                <h4><%= clinic.clinic_name %></h4>

                                <p><%= clinic.description ? clinic.description : 'Quality care from our specialists.' %></p>

                            </div>

                        </div>

                    <% }); %>

                </div>

            <% } %>

        </div>

    </section>

    <section class="how-it-works">

        <div class="container">

            <div class="text-center mb-5">

                <h2>How It Works</h2>

                <p>Book your appointment in four simple steps.</p>

            </div>

            <div class="row">

                <div class="col-lg-3">

                    <div class="step">

                        <div class="number">1</div>

                        <h4>Register</h4>

                        <p>Create your patient account.</p>

                    </div>

                </div>

                <div class="col-lg-3">

                    <div class="step">

                        <div class="number">2</div>

                        <h4>Book</h4>

                        <p>Select doctor and date.</p>

                    </div>

                </div>

                <div class="col-lg-3">

                    <div class="step">

                        <div class="number">3</div>

                        <h4>Queue Number</h4>

                        <p>Receive your queue instantly.</p>

                    </div>

                </div>

                <div class="col-lg-3">

                    <div class="step">

                        <div class="number">4</div>

                        <h4>Visit Doctor</h4>

                        <p>Track queue and meet doctor.</p>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- ===================== SPECIALISTS (LIVE) ===================== -->

    <section class="doctors">

        <div class="container">

            <div class="text-center">

                <h2>Meet Our Specialists</h2>

                <p>Experienced doctors committed to quality care.</p>

            </div>

            <% if (featuredDoctors.length === 0) { %>

                <p class="text-center mt-4" style="color:#64748b;">
                    Doctor profiles will be available soon.
                </p>

            <% } else { %>

                <div class="row mt-5">

                    <% featuredDoctors.forEach(function(doc) { %>

                        <div class="col-lg-4">

                            <div class="doctor-card">

                                <img src="<%= doc.profile_image ? doc.profile_image : '/images/default-user.png' %>" alt="Dr. <%= doc.full_name %>">

                                <h4>Dr. <%= doc.full_name %></h4>

                                <p><%= doc.specialization ? doc.specialization : 'General Practitioner' %></p>

                            </div>

                        </div>

                    <% }); %>

                </div>

            <% } %>

        </div>

    </section>

    <!-- ===================== FOOTER ===================== -->

    <%- include('../partials/publicFooter') %>

    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>

</body>

</html>
