<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About MediQ | Mahiyanganaya Base Hospital</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- About Page CSS -->
    <link rel="stylesheet" href="/css/about.css">
</head>

<body>

    <!-- ===================== NAVBAR ===================== -->

    <%- include('../partials/publicNavbar', { currentPage: 'about' }) %>

    <!-- ===================== PAGE HERO ===================== -->

    <section class="about-hero">

        <div class="container">

            <span class="badge-health">
                <i class="bi bi-hospital"></i>
                About Us
            </span>

            <h1>
                Caring for Mahiyanganaya,
                <span>One Patient at a Time.</span>
            </h1>

            <p>
                Mahiyanganaya Base Hospital has served the Mahiyanganaya region and
                surrounding rural communities for years, providing accessible
                government healthcare. MediQ is the
                next step in that mission — bringing digital convenience to the
                way patients book, wait, and receive care.
            </p>

        </div>

    </section>

    <!-- ===================== OUR STORY ===================== -->

    <section class="our-story">

        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-6">

                    <div class="our-story-image">
                        <img src="/images/hospital.jpg" alt="Mahiyanganaya Base Hospital" class="img-fluid">
                    </div>

                </div>

                <div class="col-lg-6">

                    <div class="our-story-content">

                        <span class="badge-health">
                            <i class="bi bi-clock-history"></i>
                            Our Story
                        </span>

                        <h2>Serving Our Community With Dedication</h2>

                        <p>
                            As a government healthcare institution, Mahiyanganaya Base
                            Hospital handles hundreds of patient visits every day —
                            consultations, clinic services, and laboratory work for
                            people across the region, including many from remote
                            villages who travel significant distances for care.
                        </p>

                        <p>
                            For years, that meant long queues, crowded waiting areas,
                            and no way for patients to know how long they'd be
                            waiting. We recognized that improving healthcare wasn't
                            only about clinical care — it was also about respecting
                            our patients' time. That's why we built a smart queue
                            system that lets patients book online, receive a digital
                            queue number, and track their turn in real time, all
                            without needing to arrive hours early and wait.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- ===================== MISSION & VISION ===================== -->

    <section class="mission-vision">

        <div class="container">

            <div class="text-center mb-5">

                <h2 style="font-weight:800; color:#111827;">Our Mission &amp; Vision</h2>

                <p style="color:#64748b; margin-top:10px;">
                    What drives every decision we make.
                </p>

            </div>

            <div class="row g-4">

                <div class="col-lg-6">

                    <div class="mv-card">

                        <i class="bi bi-bullseye"></i>

                        <h3>Our Mission</h3>

                        <p>
                            To deliver accessible, efficient, and patient-centered
                            healthcare to the Mahiyanganaya community by reducing
                            unnecessary waiting, improving communication, and
                            supporting our doctors and staff with tools that let
                            them focus on what matters most — patient care.
                        </p>

                    </div>

                </div>

                <div class="col-lg-6">

                    <div class="mv-card">

                        <i class="bi bi-eye"></i>

                        <h3>Our Vision</h3>

                        <p>
                            To be a model for digital transformation in government
                            healthcare institutions across Sri Lanka — demonstrating
                            that thoughtful technology can meaningfully improve care
                            delivery, even within the constraints public hospitals
                            operate under.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- ===================== CORE VALUES ===================== -->

    <section class="core-values">

        <div class="container">

            <div class="text-center mb-5">

                <h2 style="font-weight:800; color:#111827;">Our Core Values</h2>

                <p style="color:#64748b; margin-top:10px;">
                    The principles behind how we treat every patient who walks through our doors.
                </p>

            </div>

            <div class="row g-4">

                <div class="col-lg-3 col-md-6">

                    <div class="value-card">
                        <i class="bi bi-heart-fill"></i>
                        <h4>Compassion</h4>
                        <p>Every patient is treated with empathy, dignity, and respect.</p>
                    </div>

                </div>

                <div class="col-lg-3 col-md-6">

                    <div class="value-card">
                        <i class="bi bi-award-fill"></i>
                        <h4>Excellence</h4>
                        <p>We hold ourselves to high clinical and service standards.</p>
                    </div>

                </div>

                <div class="col-lg-3 col-md-6">

                    <div class="value-card">
                        <i class="bi bi-shield-check"></i>
                        <h4>Integrity</h4>
                        <p>Transparent, honest care and communication, always.</p>
                    </div>

                </div>

                <div class="col-lg-3 col-md-6">

                    <div class="value-card">
                        <i class="bi bi-people-fill"></i>
                        <h4>Accessibility</h4>
                        <p>Quality healthcare should be reachable for every patient in our region.</p>
                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- ===================== STATS STRIP ===================== -->

    <section class="about-stats">

        <div class="container">

            <div class="row text-center g-4">

                <div class="col-md-3 col-6">
                    <h2>15K+</h2>
                    <p>Patients Served</p>
                </div>

                <div class="col-md-3 col-6">
                    <h2>25+</h2>
                    <p>Doctors</p>
                </div>

                <div class="col-md-3 col-6">
                    <h2>5</h2>
                    <p>Departments</p>
                </div>

                <div class="col-md-3 col-6">
                    <h2>24/7</h2>
                    <p>Online Booking</p>
                </div>

            </div>

        </div>

    </section>

    <!-- ===================== CTA ===================== -->

    <section class="about-cta">

        <div class="container">

            <h2>Ready for Faster, Simpler Healthcare?</h2>

            <p>
                Create your patient account and book your first appointment online in minutes.
            </p>

            <div>

                <a href="/register" class="btn btn-primary-custom">
                    Get Started
                    <i class="bi bi-arrow-right"></i>
                </a>

                <a href="/contact" class="btn btn-outline-custom">
                    Contact Us
                </a>

            </div>

        </div>

    </section>

    <!-- ===================== FOOTER ===================== -->

    <%- include('../partials/publicFooter') %>

    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>

</body>

</html>
