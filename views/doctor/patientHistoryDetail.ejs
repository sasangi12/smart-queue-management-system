<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title><%= patient.full_name %> — Patient History | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS (shared theme) -->

    <link rel="stylesheet"
          href="/css/doctorDashboard.css">

    <!-- Patient History CSS -->

    <link rel="stylesheet"
          href="/css/doctorPatientHistory.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/doctorSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/doctorNavbar') %>

    <!-- Page Content -->

    <div class="dashboard-content">

        <a href="/doctor/patientHistory" class="back-to-list-link">
            <i class="bi bi-arrow-left"></i>
            Back to Patient List
        </a>

        <!-- =====================================
                Patient Header
        ====================================== -->

        <div class="patient-detail-header">

            <img class="patient-detail-avatar"
                 src="<%= patient.profile_image ? patient.profile_image : '/images/default-user.png' %>"
                 alt="<%= patient.full_name %>">

            <div class="patient-detail-info">

                <h3><%= patient.full_name %></h3>

                <p><i class="bi bi-telephone me-1"></i> <%= patient.phone %></p>
                <p><i class="bi bi-envelope me-1"></i> <%= patient.email %></p>

                <p>

                    <% if (patient.gender) { %> <%= patient.gender %> <% } %>
                    <% if (patient.gender && patient.dob) { %> &middot; <% } %>
                    <% if (patient.dob) { %>
                        Born <%= new Date(patient.dob).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                    <% } %>

                </p>

            </div>

        </div>

        <!-- =====================================
                Visit Summary
        ====================================== -->

        <div class="history-stats-grid">

            <div class="history-stat-box">
                <h2><%= stats.totalVisits %></h2>
                <span>Total Visits</span>
            </div>

            <div class="history-stat-box">
                <h2><%= stats.completedCount %></h2>
                <span>Completed</span>
            </div>

            <div class="history-stat-box">
                <h2><%= stats.cancelledCount %></h2>
                <span>Cancelled</span>
            </div>

        </div>

        <!-- =====================================
                Visit History Table
        ====================================== -->

        <div class="content-card">

            <h3>Visit History</h3>

            <div class="table-responsive">

                <table class="dashboard-table">

                    <thead>

                        <tr>

                            <th>Date</th>
                            <th>Time</th>
                            <th>Clinic</th>
                            <th>Queue No</th>
                            <th>Priority</th>
                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% history.forEach(function(h) { %>

                            <%
                                let badgeClass = 'badge-pending';

                                if (h.appointment_status === 'Completed') badgeClass = 'badge-completed';
                                else if (h.appointment_status === 'Cancelled') badgeClass = 'badge-cancelled';
                                else if (h.appointment_status === 'Confirmed') badgeClass = 'badge-confirmed';
                            %>

                            <tr>

                                <td>
                                    <%= new Date(h.appointment_date).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                </td>

                                <td><%= h.start_time %> - <%= h.end_time %></td>

                                <td><%= h.clinic_name %></td>

                                <td><%= h.queue_number ? h.queue_number : '—' %></td>

                                <td>

                                    <% if (h.priority_type && h.priority_type !== 'Normal') { %>
                                        <span class="priority-chip"><%= h.priority_type %></span>
                                    <% } else { %>
                                        <span class="text-muted">—</span>
                                    <% } %>

                                </td>

                                <td>
                                    <span class="badge <%= badgeClass %>"><%= h.appointment_status %></span>
                                </td>

                            </tr>

                        <% }); %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Sidebar Toggle -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle) {

        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });

    }

});

</script>

</body>

</html>
