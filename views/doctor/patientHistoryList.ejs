<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Patient History | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS (shared theme) -->

    <link rel="stylesheet"
          href="/css/doctorDashboard.css">

    <!-- Patient History CSS -->

    <link rel="stylesheet"
          href="/css/doctorPatientHistory.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/doctorSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/doctorNavbar') %>

    <!-- Page Content -->

    <div class="dashboard-content">

        <div class="section-header">

            <div>

                <h3 class="section-title mb-1">Patient History</h3>
                <p class="section-subtitle">Look up any patient you've treated and review their visit history with you.</p>

            </div>

        </div>

        <% if (errorMsg) { %>

            <div class="booking-alert error" style="padding:16px 20px; border-radius:14px; background:#fee2e2; color:#dc2626; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span><%= errorMsg %></span>
            </div>

        <% } %>

        <!-- =====================================
                Search Bar
        ====================================== -->

        <div class="patient-search-bar">

            <form action="/doctor/patientHistory" method="GET">

                <input type="text"
                       name="search"
                       placeholder="Search by patient name or phone number..."
                       value="<%= searchTerm %>">

                <button type="submit">
                    <i class="bi bi-search me-1"></i>Search
                </button>

                <% if (searchTerm) { %>

                    <a href="/doctor/patientHistory" class="clear-search-link">
                        Clear
                    </a>

                <% } %>

            </form>

        </div>

        <!-- =====================================
                Patient List
        ====================================== -->

        <div class="content-card">

            <% if (patients.length === 0) { %>

                <div class="empty-state">

                    <i class="bi bi-person-x"></i>

                    <% if (searchTerm) { %>

                        <h4>No Matches Found</h4>
                        <p>No patient matching "<%= searchTerm %>" was found in your patient history.</p>

                    <% } else { %>

                        <h4>No Patients Yet</h4>
                        <p>Once you've treated a patient, they'll appear here.</p>

                    <% } %>

                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="dashboard-table">

                        <thead>

                            <tr>

                                <th>Patient</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th>Total Visits</th>
                                <th>Last Visit</th>
                                <th>Action</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% patients.forEach(function(p) { %>

                                <tr>

                                    <td><%= p.patient_name %></td>

                                    <td><%= p.phone %></td>

                                    <td><%= p.email %></td>

                                    <td>
                                        <span class="visit-count-badge">
                                            <%= p.visit_count %> visit<%= p.visit_count !== 1 ? 's' : '' %>
                                        </span>
                                    </td>

                                    <td>

                                        <%= p.last_visit_date ? new Date(p.last_visit_date).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %>

                                    </td>

                                    <td>

                                        <a href="/doctor/patientHistory/<%= p.patient_id %>" class="view-history-btn">
                                            <i class="bi bi-clock-history"></i>
                                            View History
                                        </a>

                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Sidebar Toggle -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle) {

        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });

    }

});

</script>

</body>

</html>
