<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Doctor Dashboard | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS -->

    <link rel="stylesheet"
          href="/css/doctorDashboard.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/doctorSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/doctorNavbar') %>

    <!-- Dashboard Content -->

    <div class="dashboard-content">

        <!-- =====================================
                Welcome Banner
        ====================================== -->

        <div class="welcome-banner">

            <div>

                <h2>

                    Welcome Back, Dr. <%= user ? user.full_name : "Doctor" %> 👋

                </h2>

                <p>

                    <% if (doctor) { %>

                        <%= doctor.specialization ? doctor.specialization : 'Doctor' %>
                        <% if (doctor.room_no) { %> &middot; Room <%= doctor.room_no %> <% } %>
                        &mdash; here's an overview of today's patients and queue.

                    <% } else { %>

                        Here's an overview of today's patients and queue.

                    <% } %>

                </p>

            </div>

            <div>

                <i class="bi bi-heart-pulse"></i>

            </div>

        </div>

        <!-- =====================================
                Statistics Cards
        ====================================== -->

        <div class="stats-grid">

            <!-- Today's Appointments -->

            <div class="stat-card">

                <div class="stat-info">

                    <h4>Today's Appointments</h4>

                    <h2><%= stats.todayCount %></h2>

                </div>

                <div class="stat-icon">

                    <i class="bi bi-calendar-check"></i>

                </div>

            </div>

            <!-- Patients Waiting -->

            <div class="stat-card">

                <div class="stat-info">

                    <h4>Patients Waiting</h4>

                    <h2><%= stats.waitingCount %></h2>

                </div>

                <div class="stat-icon">

                    <i class="bi bi-hourglass-split"></i>

                </div>

            </div>

            <!-- Now Serving -->

            <div class="stat-card">

                <div class="stat-info">

                    <h4>Now Serving</h4>

                    <% if (stats.nowServing) { %>

                        <h2><%= stats.nowServing %></h2>

                    <% } else { %>

                        <h2 style="font-size:20px; color:#94a3b8;">Not Started</h2>

                    <% } %>

                </div>

                <div class="stat-icon">

                    <i class="bi bi-people-fill"></i>

                </div>

            </div>

            <!-- Total Patients -->

            <div class="stat-card">

                <div class="stat-info">

                    <h4>Total Patients</h4>

                    <h2><%= stats.totalPatients %></h2>

                </div>

                <div class="stat-icon">

                    <i class="bi bi-person-badge"></i>

                </div>

            </div>

        </div>

        <!-- =====================================
                Quick Actions
        ====================================== -->

        <div class="quick-actions">

            <div class="section-header">

                <h3>

                    Quick Actions

                </h3>

            </div>

            <div class="action-grid">

                <!-- Today's Appointments -->

                <a href="/doctor/appointments"

                   class="action-card">

                    <i class="bi bi-calendar-check"></i>

                    <h4>

                        Today's Appointments

                    </h4>

                    <p>

                        View your full patient list for today.

                    </p>

                </a>

                <!-- Manage Queue -->

                <a href="/doctor/queue"

                   class="action-card">

                    <i class="bi bi-people-fill"></i>

                    <h4>

                        Manage Queue

                    </h4>

                    <p>

                        Call the next patient and update queue progress.

                    </p>

                </a>

                <!-- Patient History -->

                <a href="/doctor/patientHistory"

                   class="action-card">

                    <i class="bi bi-clock-history"></i>

                    <h4>

                        Patient History

                    </h4>

                    <p>

                        Look up a patient's past visits and records.

                    </p>

                </a>

                <!-- My Profile -->

                <a href="/doctor/profile"

                   class="action-card">

                    <i class="bi bi-person-circle"></i>

                    <h4>

                        My Profile

                    </h4>

                    <p>

                        Update your personal and professional details.

                    </p>

                </a>

            </div>

        </div>

        <!-- =====================================
                Dashboard Bottom Section
        ====================================== -->

        <div class="row mt-4">

            <!-- =====================================
                    Today's Patient List
            ====================================== -->

            <div class="col-lg-8">

                <div class="content-card">

                    <div class="section-header">

                        <h3>

                            Today's Patient List

                        </h3>

                        <a href="/doctor/appointments">

                            View All

                        </a>

                    </div>

                    <% if (todayAppointments.length === 0) { %>

                        <div class="empty-state">

                            <i class="bi bi-calendar-x"></i>
                            <h4>No Appointments Today</h4>
                            <p>You have no scheduled patients for today.</p>

                        </div>

                    <% } else { %>

                        <div class="table-responsive">

                            <table class="dashboard-table">

                                <thead>

                                    <tr>

                                        <th>Queue No</th>

                                        <th>Patient</th>

                                        <th>Clinic</th>

                                        <th>Time</th>

                                        <th>Status</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    <% todayAppointments.forEach(function(apt) { %>

                                        <%
                                            let queueBadgeClass = 'badge-pending';

                                            if (apt.queue_status === 'Serving') queueBadgeClass = 'badge-confirmed';
                                            else if (apt.queue_status === 'Completed') queueBadgeClass = 'badge-completed';
                                            else if (apt.queue_status === 'Skipped') queueBadgeClass = 'badge-cancelled';
                                        %>

                                        <tr>

                                            <td><%= apt.queue_number ? apt.queue_number : '—' %></td>

                                            <td>

                                                <%= apt.patient_name %>

                                                <% if (apt.priority_type && apt.priority_type !== 'Normal') { %>
                                                    <span class="priority-chip"><%= apt.priority_type %></span>
                                                <% } %>

                                            </td>

                                            <td><%= apt.clinic_name %></td>

                                            <td><%= apt.start_time %></td>

                                            <td>

                                                <span class="badge <%= queueBadgeClass %>">
                                                    <%= apt.queue_status ? apt.queue_status : 'Not in Queue' %>
                                                </span>

                                            </td>

                                        </tr>

                                    <% }); %>

                                </tbody>

                            </table>

                        </div>

                    <% } %>

                </div>

            </div>

            <!-- =====================================
                    Latest Notifications
            ====================================== -->

            <div class="col-lg-4">

                <div class="content-card">

                    <div class="section-header">

                        <h3>

                            Latest Notifications

                        </h3>

                        <a href="/doctor/notifications">

                            View All

                        </a>

                    </div>

                    <% if (recentNotifications.length === 0) { %>

                        <div class="empty-state">

                            <i class="bi bi-bell-slash"></i>
                            <h4>No Notifications</h4>
                            <p>You're all caught up.</p>

                        </div>

                    <% } else { %>

                        <div class="notification-panel">

                            <% recentNotifications.forEach(function(n) { %>

                                <%
                                    let iconClass = 'bi-bell-fill';

                                    const type = (n.notification_type || '').toLowerCase();

                                    if (type.includes('appointment')) iconClass = 'bi-calendar-check-fill';
                                    else if (type.includes('queue')) iconClass = 'bi-people-fill';
                                    else if (type.includes('cancel')) iconClass = 'bi-x-circle-fill';

                                    const sentDate = new Date(n.sent_date);
                                %>

                                <div class="notification-item">

                                    <div class="notification-icon">

                                        <i class="bi <%= iconClass %>"></i>

                                    </div>

                                    <div class="notification-content">

                                        <h5><%= n.title %></h5>

                                        <p><%= n.message %></p>

                                        <small>
                                            <%= sentDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %>
                                            &middot;
                                            <%= sentDate.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                                        </small>

                                    </div>

                                </div>

                            <% }); %>

                        </div>

                    <% } %>

                </div>

            </div>

        </div>

        <!-- =====================================
                FOOTER
        ====================================== -->

        <footer class="dashboard-footer mt-5">

            <div class="row">

                <div class="col-md-6">

                    <p>

                        © 2026 MediQ.
                        All Rights Reserved.

                    </p>

                </div>

                <div class="col-md-6 text-end">

                    <p>

                        Developed by
                        <strong>Sasangi Navodya</strong>

                    </p>

                </div>

            </div>

        </footer>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Sidebar Toggle -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle) {

        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });

    }

});

</script>

</body>

</html>
