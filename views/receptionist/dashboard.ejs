<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Receptionist Dashboard | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS -->

    <link rel="stylesheet"
          href="/css/receptionistDashboard.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/receptionistSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/receptionistNavbar') %>

    <!-- Dashboard Content -->

    <div class="dashboard-content">

        <!-- =====================================
                Welcome Banner
        ====================================== -->

        <div class="welcome-banner">

            <div>

                <h2>

                    Welcome Back, <%= user ? user.full_name : "Receptionist" %> 👋

                </h2>

                <p>

                    Here's today's front desk overview — appointments,
                    registrations, and queue activity across every clinic.

                </p>

            </div>

            <div>

                <i class="bi bi-person-workspace"></i>

            </div>

        </div>

        <!-- =====================================
                Statistics Cards
        ====================================== -->

        <div class="stats-grid">

            <!-- Today's Appointments -->

            <div class="stat-card">

                <div class="stat-info">

                    <h4>Today's Appointments</h4>

                    <h2><%= stats.todayCount %></h2>

                </div>

                <div class="stat-icon">

                    <i class="bi bi-calendar-check"></i>

                </div>

            </div>

            <!-- Patients Waiting -->

            <div class="stat-card">

                <div class="stat-info">

                    <h4>Patients Waiting</h4>

                    <h2><%= stats.waitingCount %></h2>

                </div>

                <div class="stat-icon">

                    <i class="bi bi-hourglass-split"></i>

                </div>

            </div>

            <!-- Active Sessions Today -->

            <div class="stat-card">

                <div class="stat-info">

                    <h4>Active Sessions Today</h4>

                    <h2><%= stats.todaySessions %></h2>

                </div>

                <div class="stat-icon">

                    <i class="bi bi-calendar3"></i>

                </div>

            </div>

            <!-- Total Registered Patients -->

            <div class="stat-card">

                <div class="stat-info">

                    <h4>Total Patients</h4>

                    <h2><%= stats.totalPatients %></h2>

                </div>

                <div class="stat-icon">

                    <i class="bi bi-people-fill"></i>

                </div>

            </div>

        </div>

        <!-- =====================================
                Quick Actions
        ====================================== -->

        <div class="quick-actions">

            <div class="section-header">

                <h3>

                    Quick Actions

                </h3>

            </div>

            <div class="action-grid">

                <!-- Register Patient -->

                <a href="/receptionist/registerPatient"

                   class="action-card">

                    <i class="bi bi-person-plus"></i>

                    <h4>

                        Register Patient

                    </h4>

                    <p>

                        Walk-in patient registration and profile creation.

                    </p>

                </a>

                <!-- Appointments -->

                <a href="/receptionist/appointments"

                   class="action-card">

                    <i class="bi bi-calendar-check"></i>

                    <h4>

                        Appointments

                    </h4>

                    <p>

                        View and manage bookings across every clinic.

                    </p>

                </a>

                <!-- Queue Overview -->

                <a href="/receptionist/queue"

                   class="action-card">

                    <i class="bi bi-people-fill"></i>

                    <h4>

                        Queue Overview

                    </h4>

                    <p>

                        Monitor live queue activity hospital-wide.

                    </p>

                </a>

                <!-- My Profile -->

                <a href="/receptionist/profile"

                   class="action-card">

                    <i class="bi bi-person-circle"></i>

                    <h4>

                        My Profile

                    </h4>

                    <p>

                        Update your personal information and account details.

                    </p>

                </a>

            </div>

        </div>

        <!-- =====================================
                Dashboard Bottom Section
        ====================================== -->

        <div class="row mt-4">

            <!-- =====================================
                    Today's Appointment Overview
            ====================================== -->

            <div class="col-lg-8">

                <div class="content-card">

                    <div class="section-header">

                        <h3>

                            Today's Appointment Overview

                        </h3>

                        <a href="/receptionist/appointments">

                            View All

                        </a>

                    </div>

                    <% if (todayAppointments.length === 0) { %>

                        <div class="empty-state">

                            <i class="bi bi-calendar-x"></i>
                            <h4>No Appointments Today</h4>
                            <p>There are no bookings scheduled across any clinic today.</p>

                        </div>

                    <% } else { %>

                        <div class="table-responsive">

                            <table class="dashboard-table">

                                <thead>

                                    <tr>

                                        <th>Queue No</th>

                                        <th>Patient</th>

                                        <th>Doctor</th>

                                        <th>Clinic</th>

                                        <th>Time</th>

                                        <th>Status</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    <% todayAppointments.forEach(function(apt) { %>

                                        <%
                                            let queueBadgeClass = 'badge-pending';

                                            if (apt.queue_status === 'Serving') queueBadgeClass = 'badge-confirmed';
                                            else if (apt.queue_status === 'Completed') queueBadgeClass = 'badge-completed';
                                            else if (apt.queue_status === 'Skipped') queueBadgeClass = 'badge-cancelled';
                                        %>

                                        <tr>

                                            <td><%= apt.queue_number ? apt.queue_number : '—' %></td>

                                            <td><%= apt.patient_name %></td>

                                            <td><%= apt.doctor_name %></td>

                                            <td><%= apt.clinic_name %></td>

                                            <td><%= apt.start_time %></td>

                                            <td>

                                                <span class="badge <%= queueBadgeClass %>">
                                                    <%= apt.queue_status ? apt.queue_status : 'Not in Queue' %>
                                                </span>

                                            </td>

                                        </tr>

                                    <% }); %>

                                </tbody>

                            </table>

                        </div>

                    <% } %>

                </div>

            </div>

            <!-- =====================================
                    Latest Notifications
            ====================================== -->

            <div class="col-lg-4">

                <div class="content-card">

                    <div class="section-header">

                        <h3>

                            Latest Notifications

                        </h3>

                        <a href="/receptionist/notifications">

                            View All

                        </a>

                    </div>

                    <% if (recentNotifications.length === 0) { %>

                        <div class="empty-state">

                            <i class="bi bi-bell-slash"></i>
                            <h4>No Notifications</h4>
                            <p>You're all caught up.</p>

                        </div>

                    <% } else { %>

                        <div class="notification-panel">

                            <% recentNotifications.forEach(function(n) { %>

                                <%
                                    let iconClass = 'bi-bell-fill';

                                    const type = (n.notification_type || '').toLowerCase();

                                    if (type.includes('appointment')) iconClass = 'bi-calendar-check-fill';
                                    else if (type.includes('queue')) iconClass = 'bi-people-fill';
                                    else if (type.includes('cancel')) iconClass = 'bi-x-circle-fill';

                                    const sentDate = new Date(n.sent_date);
                                %>

                                <div class="notification-item">

                                    <div class="notification-icon">

                                        <i class="bi <%= iconClass %>"></i>

                                    </div>

                                    <div class="notification-content">

                                        <h5><%= n.title %></h5>

                                        <p><%= n.message %></p>

                                        <small>
                                            <%= sentDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %>
                                            &middot;
                                            <%= sentDate.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                                        </small>

                                    </div>

                                </div>

                            <% }); %>

                        </div>

                    <% } %>

                </div>

            </div>

        </div>

        <!-- =====================================
                FOOTER
        ====================================== -->

        <footer class="dashboard-footer mt-5">

            <div class="row">

                <div class="col-md-6">

                    <p>

                        © 2026 MediQ.
                        All Rights Reserved.

                    </p>

                </div>

                <div class="col-md-6 text-end">

                    <p>

                        Developed by
                        <strong>Sasangi Navodya</strong>

                    </p>

                </div>

            </div>

        </footer>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Sidebar Toggle -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle) {

        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });

    }

});

</script>

</body>

</html>
