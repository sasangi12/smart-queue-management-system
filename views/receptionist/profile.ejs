<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>My Profile | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS (shared theme) -->

    <link rel="stylesheet" href="/css/receptionistDashboard.css">

    <!-- Profile CSS (same generic file the Patient/Doctor/
         Receptionist profile pages already use) -->

    <link rel="stylesheet"
          href="/css/profile.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/receptionistSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/receptionistNavbar') %>

    <!-- Page Content -->

    <div class="dashboard-content">

        <div class="section-header">

            <div>

                <h3 class="section-title mb-1">My Profile</h3>
                <p class="section-subtitle">Manage your personal information and account security.</p>

            </div>

        </div>

        <% if (!profile) { %>

            <div class="booking-alert error" style="padding:16px 20px; border-radius:14px; background:#fee2e2; color:#dc2626; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span><%= errorMsg %></span>
            </div>

        <% } else { %>

            <!-- =====================================
                    Profile Header (with photo upload)
            ====================================== -->

            <div class="profile-header-card">

                <div class="profile-avatar-wrap">

                    <img id="profileAvatarPreview"
                         src="<%= profile.profile_image ? profile.profile_image : '/images/default-user.png' %>"
                         alt="Profile Photo">

                    <label for="avatarInput" class="avatar-edit-btn" title="Change Photo">
                        <i class="bi bi-camera-fill"></i>
                    </label>

                </div>

                <div class="profile-header-info">

                    <h3><%= profile.full_name %></h3>
                    <p><i class="bi bi-envelope me-1"></i> <%= profile.email %></p>
                    <p><i class="bi bi-telephone me-1"></i> <%= profile.phone %></p>

                    <div class="avatar-actions">

                        <label for="avatarInput" class="avatar-remove-btn" style="cursor:pointer;">
                            <i class="bi bi-upload me-1"></i>Change Photo
                        </label>

                        <% if (profile.profile_image) { %>

                            <button type="button" class="avatar-remove-btn" id="deletePhotoBtn">
                                <i class="bi bi-trash me-1"></i>Remove Photo
                            </button>

                        <% } %>

                    </div>

                    <p class="avatar-hint">JPG, PNG or WEBP. Max 2MB.</p>

                </div>

            </div>

            <!-- Hidden upload form -- submits automatically when a file is chosen -->
            <form id="avatarUploadForm"
                  action="/receptionist/profile/uploadImage"
                  method="POST"
                  enctype="multipart/form-data"
                  style="display:none;">

                <input type="file"
                       id="avatarInput"
                       name="profileImage"
                       accept="image/png, image/jpeg, image/webp">

            </form>

            <!-- Hidden delete form -->
            <form id="avatarDeleteForm"
                  action="/receptionist/profile/deleteImage"
                  method="POST"
                  style="display:none;">
            </form>

            <!-- =====================================
                    Tabs
            ====================================== -->

            <div class="profile-tabs">

                <div class="profile-tab-btn active" data-tab="infoTab">
                    <i class="bi bi-person-lines-fill me-1"></i> Personal Information
                </div>

                <div class="profile-tab-btn" data-tab="passwordTab">
                    <i class="bi bi-shield-lock me-1"></i> Change Password
                </div>

            </div>

            <!-- =====================================
                    Personal Information Tab
            ====================================== -->

            <div class="profile-tab-panel active" id="infoTab">

                <div class="content-card">

                    <% if (successMsg) { %>

                        <div class="booking-alert success" style="padding:16px 20px; border-radius:14px; background:#dcfce7; color:#15803d; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                            <i class="bi bi-check-circle-fill"></i>
                            <span><%= successMsg %></span>
                        </div>

                    <% } %>

                    <% if (errorMsg) { %>

                        <div class="booking-alert error" style="padding:16px 20px; border-radius:14px; background:#fee2e2; color:#dc2626; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span><%= errorMsg %></span>
                        </div>

                    <% } %>

                    <form action="/receptionist/profile/update" method="POST" class="profile-form">

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label">Full Name</label>

                                <div class="input-group">

                                    <span class="input-group-text"><i class="bi bi-person-fill"></i></span>

                                    <input type="text" name="full_name" class="form-control"
                                           value="<%= profile.full_name %>" required>

                                </div>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label">Phone Number</label>

                                <div class="input-group">

                                    <span class="input-group-text"><i class="bi bi-telephone-fill"></i></span>

                                    <input type="text" name="phone" class="form-control"
                                           value="<%= profile.phone %>" required>

                                </div>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label">Email</label>

                                <div class="input-group">

                                    <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>

                                    <input type="email" name="email" class="form-control"
                                           value="<%= profile.email %>" required>

                                </div>

                            </div>

                        </div>

                        <button type="submit" class="profile-save-btn">
                            <i class="bi bi-check-circle me-1"></i>
                            Save Changes
                        </button>

                    </form>

                </div>

            </div>

            <!-- =====================================
                    Change Password Tab
            ====================================== -->

            <div class="profile-tab-panel" id="passwordTab">

                <div class="content-card">

                    <% if (passwordSuccessMsg) { %>

                        <div class="booking-alert success" style="padding:16px 20px; border-radius:14px; background:#dcfce7; color:#15803d; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                            <i class="bi bi-check-circle-fill"></i>
                            <span><%= passwordSuccessMsg %></span>
                        </div>

                    <% } %>

                    <% if (passwordErrorMsg) { %>

                        <div class="booking-alert error" style="padding:16px 20px; border-radius:14px; background:#fee2e2; color:#dc2626; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span><%= passwordErrorMsg %></span>
                        </div>

                    <% } %>

                    <form action="/receptionist/profile/changePassword" method="POST" class="profile-form">

                        <div class="row">

                            <div class="col-md-12 mb-3">

                                <label class="form-label">Current Password</label>

                                <div class="input-group">

                                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>

                                    <input type="password" name="currentPassword" class="form-control" required>

                                </div>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label">New Password</label>

                                <div class="input-group">

                                    <span class="input-group-text"><i class="bi bi-key-fill"></i></span>

                                    <input type="password" name="newPassword" class="form-control" required>

                                </div>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label">Confirm New Password</label>

                                <div class="input-group">

                                    <span class="input-group-text"><i class="bi bi-shield-lock-fill"></i></span>

                                    <input type="password" name="confirmNewPassword" class="form-control" required>

                                </div>

                            </div>

                        </div>

                        <button type="submit" class="profile-save-btn">
                            <i class="bi bi-shield-check me-1"></i>
                            Update Password
                        </button>

                    </form>

                </div>

            </div>

        <% } %>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Sidebar Toggle -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle) {

        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });

    }

});

</script>

<!-- Tab Switching -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const tabBtns = document.querySelectorAll(".profile-tab-btn");
    const tabPanels = document.querySelectorAll(".profile-tab-panel");

    tabBtns.forEach(function (btn) {

        btn.addEventListener("click", function () {

            tabBtns.forEach((b) => b.classList.remove("active"));
            tabPanels.forEach((p) => p.classList.remove("active"));

            btn.classList.add("active");

            const target = btn.getAttribute("data-tab");
            document.getElementById(target).classList.add("active");

        });

    });

    <% if (passwordSuccessMsg || passwordErrorMsg) { %>

        document.querySelector('.profile-tab-btn[data-tab="passwordTab"]').click();

    <% } %>

});

</script>

<!-- Profile Photo: Upload (auto-submit) + Delete (confirm) -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const avatarInput = document.getElementById("avatarInput");
    const avatarUploadForm = document.getElementById("avatarUploadForm");
    const deletePhotoBtn = document.getElementById("deletePhotoBtn");
    const avatarDeleteForm = document.getElementById("avatarDeleteForm");

    if (avatarInput) {

        avatarInput.addEventListener("change", function () {

            if (avatarInput.files && avatarInput.files.length > 0) {

                const maxSizeBytes = 2 * 1024 * 1024;

                if (avatarInput.files[0].size > maxSizeBytes) {

                    alert("That image is larger than 2MB. Please choose a smaller file.");
                    avatarInput.value = "";
                    return;

                }

                avatarUploadForm.submit();

            }

        });

    }

    if (deletePhotoBtn) {

        deletePhotoBtn.addEventListener("click", function () {

            if (confirm("Remove your profile photo?")) {
                avatarDeleteForm.submit();
            }

        });

    }

});

</script>

</body>

</html>
