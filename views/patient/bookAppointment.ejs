<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Book Appointment | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS (shared theme) -->

    <link rel="stylesheet"
          href="/css/patientDashboard.css">

    <!-- Book Appointment CSS -->

    <link rel="stylesheet"
          href="/css/bookAppointment.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/patientSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/patientNavbar') %>

    <!-- Page Content -->

    <div class="dashboard-content">

        <div class="section-header">

            <div>

                <h3 class="section-title mb-1">Book Appointment</h3>

                <p class="section-subtitle">
                    Select a clinic, pick an available doctor session, and confirm your booking.
                </p>

            </div>

        </div>

        <!-- =====================================
                Alerts
        ====================================== -->

        <% if (successMsg) { %>

            <div class="booking-alert success">

                <i class="bi bi-check-circle-fill"></i>

                <span><%= successMsg %></span>

            </div>

        <% } %>

        <% if (errorMsg) { %>

            <div class="booking-alert error">

                <i class="bi bi-exclamation-circle-fill"></i>

                <span><%= errorMsg %></span>

            </div>

        <% } %>

        <div id="clientErrorAlert" class="booking-alert error" style="display:none;">

            <i class="bi bi-exclamation-circle-fill"></i>

            <span id="clientErrorText"></span>

        </div>

        <!-- =====================================
                Step Indicator
        ====================================== -->

        <div class="booking-steps">

            <div class="booking-step active" id="stepIndicator1">

                <div class="step-circle">1</div>
                <span>Select Clinic</span>

            </div>

            <div class="step-divider"></div>

            <div class="booking-step" id="stepIndicator2">

                <div class="step-circle">2</div>
                <span>Choose Doctor & Time</span>

            </div>

            <div class="step-divider"></div>

            <div class="booking-step" id="stepIndicator3">

                <div class="step-circle">3</div>
                <span>Confirm</span>

            </div>

        </div>

        <form action="/patient/bookAppointment" method="POST" id="bookingForm">

            <input type="hidden" name="schedule_id" id="selectedScheduleId">
            <input type="hidden" name="priority_type" id="selectedPriority" value="Normal">

            <!-- =====================================
                    Step 1: Select Clinic
            ====================================== -->

            <div class="content-card">

                <h3><i class="bi bi-building me-2"></i>Select Clinic</h3>

                <% if (clinics.length === 0) { %>

                    <div class="schedule-empty">

                        <i class="bi bi-building-x"></i>
                        <p>No clinics are available right now. Please check back later.</p>

                    </div>

                <% } else { %>

                    <div class="clinic-select-grid">

                        <% clinics.forEach(function(clinic) { %>

                            <div class="clinic-select-card"
                                 data-clinic-id="<%= clinic.clinic_id %>"
                                 data-clinic-name="<%= clinic.clinic_name %>">

                                <i class="bi bi-hospital"></i>
                                <h5><%= clinic.clinic_name %></h5>
                                <p><%= clinic.description ? clinic.description : 'General consultations' %></p>

                            </div>

                        <% }); %>

                    </div>

                <% } %>

            </div>

            <!-- =====================================
                    Step 2: Select Doctor Session
            ====================================== -->

            <div class="content-card" id="scheduleSection" style="display:none;">

                <h3><i class="bi bi-calendar-week me-2"></i>Available Sessions <span id="selectedClinicLabel" class="section-subtitle"></span></h3>

                <div id="scheduleList">

                    <div class="schedule-empty">

                        <i class="bi bi-hourglass-split"></i>
                        <p>Select a clinic above to see available doctor sessions.</p>

                    </div>

                </div>

            </div>

            <!-- =====================================
                    Step 3: Priority & Confirm
            ====================================== -->

            <div class="content-card" id="confirmSection" style="display:none;">

                <h3><i class="bi bi-clipboard2-check me-2"></i>Priority & Confirmation</h3>

                <p class="section-subtitle mb-3">
                    Select the category that applies to you. This helps hospital staff manage the queue fairly.
                </p>

                <div class="priority-grid mb-4">

                    <div class="priority-option selected" data-value="Normal">
                        <i class="bi bi-person d-block mb-1"></i>
                        Normal
                    </div>

                    <div class="priority-option" data-value="Elderly">
                        <i class="bi bi-person-walking d-block mb-1"></i>
                        Elderly
                    </div>

                    <div class="priority-option" data-value="Pregnant">
                        <i class="bi bi-person-hearts d-block mb-1"></i>
                        Pregnant
                    </div>

                    <div class="priority-option" data-value="Disabled">
                        <i class="bi bi-universal-access d-block mb-1"></i>
                        Disabled
                    </div>

                </div>

                <button type="submit" class="primary-btn" style="border:none; cursor:pointer;">
                    <i class="bi bi-check-circle me-1"></i>
                    Confirm Booking
                </button>

            </div>

        </form>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Dashboard JS -->

<script src="/js/patientDashboard.js"></script>

<!-- Sidebar Toggle -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle) {

        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });

    }

});

</script>

<!-- Booking Logic -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const clinicCards = document.querySelectorAll(".clinic-select-card");
    const scheduleSection = document.getElementById("scheduleSection");
    const scheduleList = document.getElementById("scheduleList");
    const confirmSection = document.getElementById("confirmSection");
    const selectedScheduleId = document.getElementById("selectedScheduleId");
    const selectedPriority = document.getElementById("selectedPriority");
    const selectedClinicLabel = document.getElementById("selectedClinicLabel");
    const stepIndicator2 = document.getElementById("stepIndicator2");
    const stepIndicator3 = document.getElementById("stepIndicator3");
    const priorityOptions = document.querySelectorAll(".priority-option");
    const bookingForm = document.getElementById("bookingForm");
    const clientErrorAlert = document.getElementById("clientErrorAlert");
    const clientErrorText = document.getElementById("clientErrorText");

    // =============================
    // Step 1: Clinic Selection
    // =============================

    clinicCards.forEach(function (card) {

        card.addEventListener("click", function () {

            clinicCards.forEach((c) => c.classList.remove("selected"));
            card.classList.add("selected");

            const clinicId = card.getAttribute("data-clinic-id");
            const clinicName = card.getAttribute("data-clinic-name");

            selectedClinicLabel.textContent = "— " + clinicName;

            // Reset downstream steps
            selectedScheduleId.value = "";
            confirmSection.style.display = "none";
            stepIndicator3.classList.remove("active");

            scheduleSection.style.display = "block";
            stepIndicator2.classList.add("active");

            loadSchedules(clinicId);

        });

    });

    // =============================
    // Fetch Schedules for Clinic
    // =============================

    function loadSchedules(clinicId) {

        scheduleList.innerHTML =
            '<div class="schedule-empty"><i class="bi bi-hourglass-split"></i><p>Loading available sessions...</p></div>';

        fetch("/patient/getSchedulesByClinic/" + clinicId)

            .then((res) => res.json())

            .then((schedules) => {

                if (!schedules || schedules.length === 0) {

                    scheduleList.innerHTML =
                        '<div class="schedule-empty"><i class="bi bi-calendar-x"></i><p>No available sessions for this clinic right now.</p></div>';

                    return;

                }

                scheduleList.innerHTML = "";

                schedules.forEach(function (s) {

                    const card = document.createElement("div");
                    card.className = "schedule-card";
                    card.setAttribute("data-schedule-id", s.schedule_id);

                    const lowSlots = s.slots_left <= 3 ? "low" : "";

                    const dateFormatted = new Date(s.date).toLocaleDateString("en-US", {
                        weekday: "short",
                        year: "numeric",
                        month: "short",
                        day: "numeric"
                    });

                    card.innerHTML =
                        '<input type="radio" name="schedule_radio">' +
                        '<span class="slots-left ' + lowSlots + '">' + s.slots_left + ' slots left</span>' +
                        '<h5>' + s.doctor_name + '</h5>' +
                        '<div class="specialization">' + (s.specialization || 'General') + '</div>' +
                        '<div class="schedule-meta">' +
                            '<span><i class="bi bi-calendar-event"></i>' + dateFormatted + '</span>' +
                            '<span><i class="bi bi-clock"></i>' + s.start_time + ' - ' + s.end_time + '</span>' +
                            (s.room_no ? '<span><i class="bi bi-door-open"></i>Room ' + s.room_no + '</span>' : '') +
                        '</div>';

                    card.addEventListener("click", function () {

                        document.querySelectorAll(".schedule-card").forEach((c) => {
                            c.classList.remove("selected");
                            c.querySelector('input[type="radio"]').checked = false;
                        });

                        card.classList.add("selected");
                        card.querySelector('input[type="radio"]').checked = true;

                        selectedScheduleId.value = s.schedule_id;

                        confirmSection.style.display = "block";
                        stepIndicator3.classList.add("active");

                    });

                    scheduleList.appendChild(card);

                });

            })

            .catch(function () {

                scheduleList.innerHTML =
                    '<div class="schedule-empty"><i class="bi bi-exclamation-triangle"></i><p>Failed to load sessions. Please try again.</p></div>';

            });

    }

    // =============================
    // Step 3: Priority Selection
    // =============================

    priorityOptions.forEach(function (opt) {

        opt.addEventListener("click", function () {

            priorityOptions.forEach((o) => o.classList.remove("selected"));
            opt.classList.add("selected");

            selectedPriority.value = opt.getAttribute("data-value");

        });

    });

    // =============================
    // Prevent submit without a schedule selected
    // =============================

    bookingForm.addEventListener("submit", function (e) {

        if (!selectedScheduleId.value) {

            e.preventDefault();

            clientErrorText.textContent = "Please select an available doctor session before confirming.";
            clientErrorAlert.style.display = "flex";

            window.scrollTo({ top: 0, behavior: "smooth" });

        }

    });

});

</script>

</body>

</html>
