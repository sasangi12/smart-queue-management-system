<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Patient Dashboard | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS -->

    <link rel="stylesheet"
          href="/css/patientDashboard.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/patientSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/patientNavbar') %>

    <!-- Dashboard Content -->

    <div class="dashboard-content">

        <!-- =====================================
                Welcome Banner
        ====================================== -->

        <div class="welcome-banner">

            <div>

                <h2>

                    Welcome Back,
                    <%= user ? user.full_name : "Guest" %> 👋

                </h2>

                <p>

                    Welcome to the Smart Queue Management System.
                    Manage your appointments, monitor your queue,
                    receive notifications, and access healthcare
                    services from one convenient dashboard.

                </p>

            </div>

            <div>

                <i class="bi bi-hospital"></i>

            </div>

        </div>

        <!-- =====================================
                Statistics Cards (LIVE DATA)
        ====================================== -->

        <div class="stats-grid">

            <!-- Total Appointments -->

            <div class="stat-card">

                <div class="stat-info">

                    <h4>Total Appointments</h4>

                    <h2><%= stats.totalAppointments %></h2>

                </div>

                <div class="stat-icon">

                    <i class="bi bi-calendar-check"></i>

                </div>

            </div>

            <!-- Current Queue -->

            <div class="stat-card">

                <div class="stat-info">

                    <h4>Current Queue</h4>

                    <% if (stats.currentQueue) { %>

                        <h2><%= stats.currentQueue.queue_number %></h2>

                    <% } else { %>

                        <h2 style="font-size:20px; color:#94a3b8;">No Active Queue</h2>

                    <% } %>

                </div>

                <div class="stat-icon">

                    <i class="bi bi-people-fill"></i>

                </div>

            </div>

            <!-- Next Appointment -->

            <div class="stat-card">

                <div class="stat-info">

                    <h4>Next Appointment</h4>

                    <% if (stats.nextAppointment) { %>

                        <h2>
                            <%= new Date(stats.nextAppointment.appointment_date).toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %>
                        </h2>

                    <% } else { %>

                        <h2 style="font-size:20px; color:#94a3b8;">None Scheduled</h2>

                    <% } %>

                </div>

                <div class="stat-icon">

                    <i class="bi bi-calendar-event"></i>

                </div>

            </div>

            <!-- Notifications -->

            <div class="stat-card">

                <div class="stat-info">

                    <h4>Notifications</h4>

                    <h2><%= typeof unreadNotifications !== 'undefined' ? unreadNotifications : 0 %></h2>

                </div>

                <div class="stat-icon">

                    <i class="bi bi-bell-fill"></i>

                </div>

            </div>

        </div>

        <!-- =====================================
                Quick Actions
        ====================================== -->

        <div class="quick-actions">

            <div class="section-header">

                <h3>

                    Quick Actions

                </h3>

            </div>

            <div class="action-grid">

                <!-- Book Appointment -->

                <a href="/patient/bookAppointment"

                   class="action-card">

                    <i class="bi bi-calendar-plus"></i>

                    <h4>

                        Book Appointment

                    </h4>

                    <p>

                        Schedule a new appointment with your preferred doctor.

                    </p>

                </a>

                <!-- My Appointments -->

                <a href="/patient/appointments"

                   class="action-card">

                    <i class="bi bi-calendar-week"></i>

                    <h4>

                        My Appointments

                    </h4>

                    <p>

                        View your upcoming and previous appointments.

                    </p>

                </a>

                <!-- Queue Status -->

                <a href="/patient/queue"

                   class="action-card">

                    <i class="bi bi-hourglass-split"></i>

                    <h4>

                        Queue Status

                    </h4>

                    <p>

                        Monitor your live queue number in real time.

                    </p>

                </a>

                <!-- My Profile -->

                <a href="/patient/profile"

                   class="action-card">

                    <i class="bi bi-person-circle"></i>

                    <h4>

                        My Profile

                    </h4>

                    <p>

                        Update your personal information and account details.

                    </p>

                </a>

            </div>

        </div>

        <!-- =====================================
                Dashboard Bottom Section
        ====================================== -->

        <div class="row mt-4">

            <!-- =====================================
                    Recent Appointments (LIVE DATA)
            ====================================== -->

            <div class="col-lg-8">

                <div class="content-card">

                    <div class="section-header">

                        <h3>

                            Recent Appointments

                        </h3>

                        <a href="/patient/appointments">

                            View All

                        </a>

                    </div>

                    <% if (stats.recentAppointments.length === 0) { %>

                        <div class="empty-state">

                            <i class="bi bi-calendar-x"></i>
                            <h4>No Appointments Yet</h4>
                            <p>Book your first appointment to see it here.</p>
                            <a href="/patient/bookAppointment" class="primary-btn">Book Appointment</a>

                        </div>

                    <% } else { %>

                        <div class="table-responsive">

                            <table class="dashboard-table">

                                <thead>

                                    <tr>

                                        <th>ID</th>

                                        <th>Doctor</th>

                                        <th>Department</th>

                                        <th>Date</th>

                                        <th>Time</th>

                                        <th>Status</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    <% stats.recentAppointments.forEach(function(apt) { %>

                                        <%
                                            const badgeClass =
                                                apt.status === "Confirmed" ? "badge-confirmed" :
                                                apt.status === "Pending" ? "badge-pending" :
                                                apt.status === "Cancelled" ? "badge-cancelled" :
                                                "badge-completed";
                                        %>

                                        <tr>

                                            <td>APT-<%= String(apt.appointment_id).padStart(4, '0') %></td>

                                            <td><%= apt.doctor_name %></td>

                                            <td><%= apt.clinic_name %></td>

                                            <td><%= new Date(apt.appointment_date).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>

                                            <td><%= apt.start_time %></td>

                                            <td>

                                                <span class="badge <%= badgeClass %>"><%= apt.status %></span>

                                            </td>

                                        </tr>

                                    <% }); %>

                                </tbody>

                            </table>

                        </div>

                    <% } %>

                </div>

            </div>

            <!-- =====================================
                    Latest Notifications (LIVE DATA)
            ====================================== -->

            <div class="col-lg-4">

                <div class="content-card">

                    <div class="section-header">

                        <h3>

                            Latest Notifications

                        </h3>

                        <a href="/patient/notifications">

                            View All

                        </a>

                    </div>

                    <% if (stats.recentNotifications.length === 0) { %>

                        <div class="empty-state">

                            <i class="bi bi-bell-slash"></i>
                            <h4>No Notifications</h4>
                            <p>You're all caught up.</p>

                        </div>

                    <% } else { %>

                        <div class="notification-panel">

                            <% stats.recentNotifications.forEach(function(n) { %>

                                <%
                                    let iconClass = 'bi-bell-fill';

                                    const type = (n.notification_type || '').toLowerCase();

                                    if (type.includes('appointment')) iconClass = 'bi-calendar-check-fill';
                                    else if (type.includes('queue')) iconClass = 'bi-people-fill';
                                    else if (type.includes('cancel')) iconClass = 'bi-x-circle-fill';

                                    const sentDate = new Date(n.sent_date);
                                %>

                                <div class="notification-item">

                                    <div class="notification-icon">

                                        <i class="bi <%= iconClass %>"></i>

                                    </div>

                                    <div class="notification-content">

                                        <h5><%= n.title %></h5>

                                        <p><%= n.message %></p>

                                        <small>
                                            <%= sentDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %>
                                            &middot;
                                            <%= sentDate.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                                        </small>

                                    </div>

                                </div>

                            <% }); %>

                        </div>

                    <% } %>

                </div>

            </div>

        </div>

        <!-- =====================================
                FOOTER
        ====================================== -->

        <footer class="dashboard-footer mt-5">

            <div class="row">

                <div class="col-md-6">

                    <p>

                        © 2026 MediQ.
                        All Rights Reserved.

                    </p>

                </div>

                <div class="col-md-6 text-end">

                    <p>

                        Developed by
                        <strong>Sasangi Navodya</strong>

                    </p>

                </div>

            </div>

        </footer>

    </div>

</div>

<!-- =====================================
        Bootstrap JS
===================================== -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- =====================================
        Dashboard JS
===================================== -->

<script src="/js/patientDashboard.js"></script>

<!-- =====================================
        Sidebar Toggle
===================================== -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");

    const sidebar = document.querySelector(".sidebar");

    if(menuToggle){

        menuToggle.addEventListener("click", function(){

            sidebar.classList.toggle("show");

        });

    }

});

</script>

</body>

</html>
