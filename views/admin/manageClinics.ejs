<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Manage Clinics | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS (shared theme) -->

    <link rel="stylesheet"
          href="/css/adminDashboard.css">

    <!-- Profile CSS (reused for the Add Clinic form fields) -->

    <link rel="stylesheet"
          href="/css/profile.css">

    <!-- Manage Doctors CSS (reused for generic table/button/
         status-badge classes -- none of those names are
         doctor-specific) -->

    <link rel="stylesheet"
          href="/css/adminManageDoctors.css">

    <!-- Manage Clinics CSS -->

    <link rel="stylesheet"
          href="/css/adminManageClinics.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/adminSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/adminNavbar') %>

    <!-- Page Content -->

    <div class="dashboard-content">

        <div class="section-header">

            <div>

                <h3 class="section-title mb-1">Manage Clinics</h3>
                <p class="section-subtitle">Add, edit, and manage hospital clinics and departments.</p>

            </div>

            <button type="button" class="toggle-add-btn" id="toggleAddBtn">
                <i class="bi bi-plus-circle"></i>
                Add Clinic
            </button>

        </div>

        <% if (successMsg) { %>

            <div class="booking-alert success" style="padding:16px 20px; border-radius:14px; background:#dcfce7; color:#15803d; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                <i class="bi bi-check-circle-fill"></i>
                <span><%= successMsg %></span>
            </div>

        <% } %>

        <% if (errorMsg) { %>

            <div class="booking-alert error" style="padding:16px 20px; border-radius:14px; background:#fee2e2; color:#dc2626; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span><%= errorMsg %></span>
            </div>

        <% } %>

        <!-- =====================================
                Add Clinic Form (hidden by default)
        ====================================== -->

        <div class="content-card" id="addClinicSection" style="display:none;">

            <h3><i class="bi bi-plus-circle-fill me-2"></i>Add New Clinic</h3>

            <form action="/admin/manageClinics/add" method="POST" class="profile-form">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">Clinic Name</label>

                        <div class="input-group">

                            <span class="input-group-text"><i class="bi bi-hospital"></i></span>

                            <input type="text" name="clinic_name" class="form-control"
                                   placeholder="e.g. Orthopedic Clinic" required>

                        </div>

                    </div>

                    <div class="col-12 mb-3">

                        <label class="form-label">Description</label>

                        <textarea name="description" class="form-control" rows="3"
                                  placeholder="Brief description shown to patients when booking"></textarea>

                    </div>

                </div>

                <button type="submit" class="profile-save-btn">
                    <i class="bi bi-plus-circle-fill me-1"></i>
                    Create Clinic
                </button>

            </form>

        </div>

        <!-- =====================================
                Search
        ====================================== -->

        <div class="clinic-search-bar">

            <form action="/admin/manageClinics" method="GET">

                <input type="text"
                       name="search"
                       placeholder="Search by clinic name or description..."
                       value="<%= searchTerm %>">

                <button type="submit">
                    <i class="bi bi-search me-1"></i>Search
                </button>

                <% if (searchTerm) { %>

                    <a href="/admin/manageClinics" class="clear-search-link">
                        Clear
                    </a>

                <% } %>

            </form>

        </div>

        <!-- =====================================
                Clinics Table
        ====================================== -->

        <div class="content-card">

            <% if (clinics.length === 0) { %>

                <div class="empty-state">

                    <i class="bi bi-hospital"></i>

                    <% if (searchTerm) { %>

                        <h4>No Matches Found</h4>
                        <p>No clinic matching "<%= searchTerm %>" was found.</p>

                    <% } else { %>

                        <h4>No Clinics Yet</h4>
                        <p>Click "Add Clinic" above to create the first one.</p>

                    <% } %>

                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="dashboard-table">

                        <thead>

                            <tr>

                                <th>Clinic</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% clinics.forEach(function(c) { %>

                                <tr>

                                    <td>

                                        <div class="clinic-icon-cell">

                                            <div class="clinic-icon">
                                                <i class="bi bi-hospital"></i>
                                            </div>

                                            <span><%= c.clinic_name %></span>

                                        </div>

                                    </td>

                                    <td><%= c.description || '—' %></td>

                                    <td>
                                        <span class="status-badge <%= c.status %>"><%= c.status %></span>
                                    </td>

                                    <td>

                                        <div class="table-actions-group">

                                            <a href="/admin/manageClinics/edit/<%= c.clinic_id %>" class="table-action-btn edit-btn">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>

                                            <form action="/admin/manageClinics/toggleStatus/<%= c.clinic_id %>" method="POST"
                                                  onsubmit="return confirm('<%= c.status === "Active" ? "Deactivate" : "Activate" %> <%= c.clinic_name %>? <%= c.status === "Active" ? "It will no longer appear when patients book new appointments." : "" %>');">

                                                <button type="submit" class="table-action-btn <%= c.status === 'Active' ? 'deactivate-btn' : 'activate-btn' %>">
                                                    <i class="bi bi-<%= c.status === 'Active' ? 'slash-circle' : 'check-circle' %>"></i>
                                                    <%= c.status === 'Active' ? 'Deactivate' : 'Activate' %>
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Sidebar Toggle -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle) {

        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });

    }

});

</script>

<!-- Toggle Add Form -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const toggleBtn = document.getElementById("toggleAddBtn");
    const addSection = document.getElementById("addClinicSection");

    toggleBtn.addEventListener("click", function () {

        const isHidden = addSection.style.display === "none";
        addSection.style.display = isHidden ? "block" : "none";

        if (isHidden) {
            addSection.scrollIntoView({ behavior: "smooth", block: "start" });
        }

    });

});

</script>

</body>

</html>
