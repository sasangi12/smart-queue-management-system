<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Reports | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS (shared theme) -->

    <link rel="stylesheet"
          href="/css/adminDashboard.css">

    <!-- Reports CSS -->

    <link rel="stylesheet"
          href="/css/adminReports.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/adminSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/adminNavbar') %>

    <!-- Page Content -->

    <div class="dashboard-content">

        <div class="section-header">

            <div>

                <h3 class="section-title mb-1">Reports</h3>
                <p class="section-subtitle">Hospital-wide statistics for any date range.</p>

            </div>

        </div>

        <!-- =====================================
                Date Range
        ====================================== -->

        <div class="report-date-bar">

            <form action="/admin/reports" method="GET" style="display:flex; align-items:flex-end; gap:15px; flex-wrap:wrap; flex:1;">

                <div class="report-date-field">
                    <label>From</label>
                    <input type="date" name="startDate" value="<%= startDate %>">
                </div>

                <div class="report-date-field">
                    <label>To</label>
                    <input type="date" name="endDate" value="<%= endDate %>">
                </div>

                <button type="submit" class="report-apply-btn">
                    <i class="bi bi-funnel me-1"></i>Apply
                </button>

            </form>

            <div class="report-preset-links">

                <a href="/admin/reports?startDate=<%= todayDateString %>&endDate=<%= todayDateString %>"
                   class="<%= (startDate === todayDateString && endDate === todayDateString) ? 'active' : '' %>">Today</a>

                <a href="/admin/reports"
                   class="<%= (startDate !== todayDateString || endDate !== todayDateString) ? 'active' : '' %>">Last 30 Days</a>

            </div>

        </div>

        <!-- =====================================
                Summary Stats
        ====================================== -->

        <div class="report-stats-grid">

            <div class="report-stat-box">
                <h2><%= summary.total %></h2>
                <span>Total Appointments</span>
            </div>

            <div class="report-stat-box completed">
                <h2><%= summary.completed %></h2>
                <span>Completed</span>
            </div>

            <div class="report-stat-box cancelled">
                <h2><%= summary.cancelled %></h2>
                <span>Cancelled</span>
            </div>

            <div class="report-stat-box skipped">
                <h2><%= summary.skipped %></h2>
                <span>Skipped</span>
            </div>

            <div class="report-stat-box">
                <h2><%= summary.newPatients %></h2>
                <span>New Patients</span>
            </div>

            <div class="report-stat-box">
                <h2><%= summary.avgWait %> min</h2>
                <span>Avg. Wait Time</span>
            </div>

        </div>

        <div class="row">

            <!-- =====================================
                    Clinic Performance (bar chart + table)
            ====================================== -->

            <div class="col-lg-6">

                <div class="content-card">

                    <div class="section-header">
                        <h3>Appointments by Clinic</h3>
                    </div>

                    <% 
                        const maxClinicCount = clinicPerformance.length > 0
                            ? Math.max(...clinicPerformance.map(c => c.total_appointments), 1)
                            : 1;
                    %>

                    <% if (clinicPerformance.length === 0) { %>

                        <div class="empty-state">
                            <i class="bi bi-hospital"></i>
                            <h4>No Data</h4>
                            <p>No clinics found for this date range.</p>
                        </div>

                    <% } else { %>

                        <% clinicPerformance.forEach(function(c) { %>

                            <%
                                const widthPct = Math.round((c.total_appointments / maxClinicCount) * 100);
                            %>

                            <div class="bar-chart-row">

                                <div class="bar-chart-label"><%= c.clinic_name %></div>

                                <div class="bar-chart-track">
                                    <div class="bar-chart-fill" style="width:<%= widthPct %>%;">
                                        <span><%= c.total_appointments %></span>
                                    </div>
                                </div>

                            </div>

                        <% }); %>

                    <% } %>

                </div>

            </div>

            <!-- =====================================
                    Registration Trend (simple summary card)
            ====================================== -->

            <div class="col-lg-6">

                <div class="content-card">

                    <div class="section-header">
                        <h3>Appointment Outcome Breakdown</h3>
                    </div>

                    <%
                        const outcomeMax = Math.max(summary.completed, summary.cancelled, summary.skipped, 1);
                        const remaining = Math.max(summary.total - summary.completed - summary.cancelled - summary.skipped, 0);
                    %>

                    <div class="bar-chart-row">
                        <div class="bar-chart-label">Completed</div>
                        <div class="bar-chart-track">
                            <div class="bar-chart-fill" style="width:<%= Math.round((summary.completed / outcomeMax) * 100) %>%; background:linear-gradient(90deg,#22c55e,#16a34a);">
                                <span><%= summary.completed %></span>
                            </div>
                        </div>
                    </div>

                    <div class="bar-chart-row">
                        <div class="bar-chart-label">Cancelled</div>
                        <div class="bar-chart-track">
                            <div class="bar-chart-fill" style="width:<%= Math.round((summary.cancelled / outcomeMax) * 100) %>%; background:linear-gradient(90deg,#ef4444,#dc2626);">
                                <span><%= summary.cancelled %></span>
                            </div>
                        </div>
                    </div>

                    <div class="bar-chart-row">
                        <div class="bar-chart-label">Skipped</div>
                        <div class="bar-chart-track">
                            <div class="bar-chart-fill" style="width:<%= Math.round((summary.skipped / outcomeMax) * 100) %>%; background:linear-gradient(90deg,#f59e0b,#d97706);">
                                <span><%= summary.skipped %></span>
                            </div>
                        </div>
                    </div>

                    <div class="bar-chart-row">
                        <div class="bar-chart-label">Still Pending / Waiting</div>
                        <div class="bar-chart-track">
                            <div class="bar-chart-fill" style="width:<%= Math.round((remaining / outcomeMax) * 100) %>%; background:linear-gradient(90deg,#94a3b8,#64748b);">
                                <span><%= remaining %></span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- =====================================
                Doctor Workload Report
        ====================================== -->

        <div class="content-card">

            <div class="section-header">

                <h3>Doctor Workload Report</h3>

                <button type="button" class="export-csv-btn" onclick="exportTableToCSV('doctorWorkloadTable', 'doctor_workload_<%= startDate %>_to_<%= endDate %>.csv')">
                    <i class="bi bi-download"></i> Export CSV
                </button>

            </div>

            <% if (doctorWorkload.length === 0) { %>

                <div class="empty-state">
                    <i class="bi bi-heart-pulse"></i>
                    <h4>No Doctors Found</h4>
                    <p>No doctors are registered in the system yet.</p>
                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="dashboard-table" id="doctorWorkloadTable">

                        <thead>

                            <tr>

                                <th>Doctor</th>
                                <th>Specialization</th>
                                <th>Total Appointments</th>
                                <th>Completed</th>
                                <th>Cancelled</th>
                                <th>Completion Rate</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% doctorWorkload.forEach(function(d) { %>

                                <%
                                    const rate = d.total_appointments > 0
                                        ? Math.round((d.completed / d.total_appointments) * 100)
                                        : null;

                                    let rateClass = 'none';
                                    if (rate !== null) {
                                        if (rate >= 75) rateClass = 'high';
                                        else if (rate >= 40) rateClass = 'mid';
                                        else rateClass = 'low';
                                    }
                                %>

                                <tr>

                                    <td>Dr. <%= d.doctor_name %></td>

                                    <td><%= d.specialization || '—' %></td>

                                    <td><%= d.total_appointments %></td>

                                    <td><%= d.completed %></td>

                                    <td><%= d.cancelled %></td>

                                    <td>
                                        <span class="completion-rate <%= rateClass %>">
                                            <%= rate !== null ? rate + '%' : 'No data' %>
                                        </span>
                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

        <!-- =====================================
                Clinic Performance Report (table)
        ====================================== -->

        <div class="content-card">

            <div class="section-header">

                <h3>Clinic Performance Report</h3>

                <button type="button" class="export-csv-btn" onclick="exportTableToCSV('clinicPerformanceTable', 'clinic_performance_<%= startDate %>_to_<%= endDate %>.csv')">
                    <i class="bi bi-download"></i> Export CSV
                </button>

            </div>

            <% if (clinicPerformance.length === 0) { %>

                <div class="empty-state">
                    <i class="bi bi-hospital"></i>
                    <h4>No Clinics Found</h4>
                    <p>No clinics are registered in the system yet.</p>
                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="dashboard-table" id="clinicPerformanceTable">

                        <thead>

                            <tr>

                                <th>Clinic</th>
                                <th>Total Appointments</th>
                                <th>Completed</th>
                                <th>Cancelled</th>
                                <th>Completion Rate</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% clinicPerformance.forEach(function(c) { %>

                                <%
                                    const rate = c.total_appointments > 0
                                        ? Math.round((c.completed / c.total_appointments) * 100)
                                        : null;

                                    let rateClass = 'none';
                                    if (rate !== null) {
                                        if (rate >= 75) rateClass = 'high';
                                        else if (rate >= 40) rateClass = 'mid';
                                        else rateClass = 'low';
                                    }
                                %>

                                <tr>

                                    <td><%= c.clinic_name %></td>

                                    <td><%= c.total_appointments %></td>

                                    <td><%= c.completed %></td>

                                    <td><%= c.cancelled %></td>

                                    <td>
                                        <span class="completion-rate <%= rateClass %>">
                                            <%= rate !== null ? rate + '%' : 'No data' %>
                                        </span>
                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Sidebar Toggle -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle) {

        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });

    }

});

</script>

<!-- CSV Export (generic -- works on any table by ID) -->

<script>

function exportTableToCSV(tableId, filename) {

    const table = document.getElementById(tableId);

    if (!table) return;

    const rows = table.querySelectorAll("tr");
    const csvLines = [];

    rows.forEach(function (row) {

        const cells = row.querySelectorAll("th, td");
        const rowData = [];

        cells.forEach(function (cell) {

            // Strip inner badge/pill markup down to plain text,
            // and escape any commas/quotes so the CSV stays valid
            let text = cell.textContent.trim().replace(/\s+/g, " ");
            text = text.replace(/"/g, '""');

            rowData.push('"' + text + '"');

        });

        csvLines.push(rowData.join(","));

    });

    const csvContent = csvLines.join("\n");
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);

    const link = document.createElement("a");
    link.href = url;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

}

</script>

</body>

</html>
