<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Edit Clinic | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS (shared theme) -->

    <link rel="stylesheet"
          href="/css/adminDashboard.css">

    <!-- Profile CSS (reused for the form fields) -->

    <link rel="stylesheet"
          href="/css/profile.css">

    <!-- Manage Doctors CSS (reused for generic classes) -->

    <link rel="stylesheet"
          href="/css/adminManageDoctors.css">

    <!-- Manage Clinics CSS -->

    <link rel="stylesheet"
          href="/css/adminManageClinics.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/adminSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/adminNavbar') %>

    <!-- Page Content -->

    <div class="dashboard-content">

        <a href="/admin/manageClinics" class="back-to-list-link">
            <i class="bi bi-arrow-left"></i>
            Back to Manage Clinics
        </a>

        <div class="section-header">

            <div>

                <h3 class="section-title mb-1">Edit Clinic</h3>
                <p class="section-subtitle">Update <%= clinic.clinic_name %>'s details.</p>

            </div>

            <span class="status-badge <%= clinic.status %>"><%= clinic.status %></span>

        </div>

        <% if (errorMsg) { %>

            <div class="booking-alert error" style="padding:16px 20px; border-radius:14px; background:#fee2e2; color:#dc2626; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span><%= errorMsg %></span>
            </div>

        <% } %>

        <% if (upcomingSchedules > 0) { %>

            <div class="upcoming-schedules-notice">
                <i class="bi bi-info-circle-fill"></i>
                This clinic has <%= upcomingSchedules %> upcoming doctor session<%= upcomingSchedules !== 1 ? 's' : '' %> scheduled. Deactivating it will only stop NEW bookings -- existing sessions and appointments are not affected.
            </div>

        <% } else { %>

            <div class="upcoming-schedules-notice none">
                <i class="bi bi-info-circle"></i>
                This clinic has no upcoming doctor sessions scheduled.
            </div>

        <% } %>

        <div class="content-card">

            <form action="/admin/manageClinics/edit/<%= clinic.clinic_id %>" method="POST" class="profile-form">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">Clinic Name</label>

                        <div class="input-group">

                            <span class="input-group-text"><i class="bi bi-hospital"></i></span>

                            <input type="text" name="clinic_name" class="form-control"
                                   value="<%= clinic.clinic_name %>" required>

                        </div>

                    </div>

                    <div class="col-12 mb-3">

                        <label class="form-label">Description</label>

                        <textarea name="description" class="form-control" rows="3"><%= clinic.description || '' %></textarea>

                    </div>

                </div>

                <button type="submit" class="profile-save-btn">
                    <i class="bi bi-check-circle me-1"></i>
                    Save Changes
                </button>

            </form>

        </div>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Sidebar Toggle -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle) {

        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });

    }

});

</script>

</body>

</html>
