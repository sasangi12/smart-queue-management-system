<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Edit Receptionist | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS (shared theme) -->

    <link rel="stylesheet"
          href="/css/adminDashboard.css">

    <!-- Profile CSS (reused for the form fields) -->

    <link rel="stylesheet"
          href="/css/profile.css">

    <!-- Manage Doctors CSS (reused for generic classes) -->

    <link rel="stylesheet"
          href="/css/adminManageDoctors.css">

    <!-- Manage Receptionists CSS -->

    <link rel="stylesheet"
          href="/css/adminManageReceptionists.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/adminSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/adminNavbar') %>

    <!-- Page Content -->

    <div class="dashboard-content">

        <a href="/admin/manageReceptionists" class="back-to-list-link">
            <i class="bi bi-arrow-left"></i>
            Back to Manage Receptionists
        </a>

        <div class="section-header">

            <div>

                <h3 class="section-title mb-1">Edit Receptionist</h3>
                <p class="section-subtitle">Update <%= receptionist.full_name %>'s account information.</p>

            </div>

        </div>

        <% if (errorMsg) { %>

            <div class="booking-alert error" style="padding:16px 20px; border-radius:14px; background:#fee2e2; color:#dc2626; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span><%= errorMsg %></span>
            </div>

        <% } %>

        <div class="content-card">

            <div class="profile-header-card" style="margin-bottom:25px;">

                <img src="<%= receptionist.profile_image ? receptionist.profile_image : '/images/default-user.png' %>"
                     alt="<%= receptionist.full_name %>"
                     style="width:80px; height:80px; border-radius:50%; object-fit:cover; border:3px solid rgba(255,255,255,.4);">

                <div class="profile-header-info">

                    <h3><%= receptionist.full_name %></h3>
                    <p><span class="status-badge <%= receptionist.status %>" style="background:rgba(255,255,255,.2); color:#fff;"><%= receptionist.status %></span></p>

                </div>

            </div>

            <form action="/admin/manageReceptionists/edit/<%= receptionist.user_id %>" method="POST" class="profile-form">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">Full Name</label>

                        <div class="input-group">

                            <span class="input-group-text"><i class="bi bi-person-fill"></i></span>

                            <input type="text" name="full_name" class="form-control"
                                   value="<%= receptionist.full_name %>" required>

                        </div>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">Phone Number</label>

                        <div class="input-group">

                            <span class="input-group-text"><i class="bi bi-telephone-fill"></i></span>

                            <input type="text" name="phone" class="form-control"
                                   value="<%= receptionist.phone %>" required>

                        </div>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">Email</label>

                        <div class="input-group">

                            <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>

                            <input type="email" name="email" class="form-control"
                                   value="<%= receptionist.email %>" required>

                        </div>

                    </div>

                </div>

                <p class="section-subtitle mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    To change this receptionist's password, ask them to use "Change Password" from their own Profile page after logging in.
                </p>

                <button type="submit" class="profile-save-btn">
                    <i class="bi bi-check-circle me-1"></i>
                    Save Changes
                </button>

            </form>

        </div>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Sidebar Toggle -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle) {

        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });

    }

});

</script>

</body>

</html>
