<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Manage Receptionists | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS (shared theme) -->

    <link rel="stylesheet"
          href="/css/adminDashboard.css">

    <!-- Profile CSS (reused for the Add Receptionist form fields) -->

    <link rel="stylesheet"
          href="/css/profile.css">

    <!-- Manage Doctors CSS (reused for generic table/button/
         status-badge/generate-password classes) -->

    <link rel="stylesheet"
          href="/css/adminManageDoctors.css">

    <!-- Manage Receptionists CSS -->

    <link rel="stylesheet"
          href="/css/adminManageReceptionists.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/adminSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/adminNavbar') %>

    <!-- Page Content -->

    <div class="dashboard-content">

        <div class="section-header">

            <div>

                <h3 class="section-title mb-1">Manage Receptionists</h3>
                <p class="section-subtitle">Add, edit, and manage front-desk staff accounts.</p>

            </div>

            <button type="button" class="toggle-add-btn" id="toggleAddBtn">
                <i class="bi bi-person-plus"></i>
                Add Receptionist
            </button>

        </div>

        <% if (successMsg) { %>

            <div class="booking-alert success" style="padding:16px 20px; border-radius:14px; background:#dcfce7; color:#15803d; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                <i class="bi bi-check-circle-fill"></i>
                <span><%= successMsg %></span>
            </div>

        <% } %>

        <% if (errorMsg) { %>

            <div class="booking-alert error" style="padding:16px 20px; border-radius:14px; background:#fee2e2; color:#dc2626; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span><%= errorMsg %></span>
            </div>

        <% } %>

        <!-- =====================================
                Add Receptionist Form (hidden by default)
        ====================================== -->

        <div class="content-card" id="addReceptionistSection" style="display:none;">

            <h3><i class="bi bi-person-plus-fill me-2"></i>Add New Receptionist</h3>

            <form action="/admin/manageReceptionists/add" method="POST" class="profile-form">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">Full Name</label>

                        <div class="input-group">

                            <span class="input-group-text"><i class="bi bi-person-fill"></i></span>

                            <input type="text" name="full_name" class="form-control"
                                   placeholder="Receptionist's full name" required>

                        </div>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">Phone Number</label>

                        <div class="input-group">

                            <span class="input-group-text"><i class="bi bi-telephone-fill"></i></span>

                            <input type="text" name="phone" class="form-control"
                                   placeholder="Phone number" required>

                        </div>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">Email</label>

                        <div class="input-group">

                            <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>

                            <input type="email" name="email" class="form-control"
                                   placeholder="Email address" required>

                        </div>

                    </div>

                    <div class="col-md-6 mb-3">

                        <!-- spacer column to keep the 2-col grid tidy -->

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">Password</label>

                        <div class="input-group">

                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>

                            <input type="text" name="password" id="passwordField" class="form-control"
                                   placeholder="At least 6 characters" required>

                        </div>

                        <button type="button" class="generate-password-btn" id="generatePasswordBtn">
                            <i class="bi bi-shuffle me-1"></i>Generate Password
                        </button>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">Confirm Password</label>

                        <div class="input-group">

                            <span class="input-group-text"><i class="bi bi-shield-lock-fill"></i></span>

                            <input type="text" name="confirmPassword" id="confirmPasswordField" class="form-control"
                                   placeholder="Re-enter password" required>

                        </div>

                        <p class="avatar-hint" style="margin-top:10px;">
                            <i class="bi bi-info-circle me-1"></i>
                            Share this password with the receptionist so they can log in.
                        </p>

                    </div>

                </div>

                <button type="submit" class="profile-save-btn">
                    <i class="bi bi-person-plus-fill me-1"></i>
                    Create Receptionist Account
                </button>

            </form>

        </div>

        <!-- =====================================
                Search
        ====================================== -->

        <div class="receptionist-search-bar">

            <form action="/admin/manageReceptionists" method="GET">

                <input type="text"
                       name="search"
                       placeholder="Search by name, email, or phone..."
                       value="<%= searchTerm %>">

                <button type="submit">
                    <i class="bi bi-search me-1"></i>Search
                </button>

                <% if (searchTerm) { %>

                    <a href="/admin/manageReceptionists" class="clear-search-link">
                        Clear
                    </a>

                <% } %>

            </form>

        </div>

        <!-- =====================================
                Receptionists Table
        ====================================== -->

        <div class="content-card">

            <% if (receptionists.length === 0) { %>

                <div class="empty-state">

                    <i class="bi bi-person-x"></i>

                    <% if (searchTerm) { %>

                        <h4>No Matches Found</h4>
                        <p>No receptionist matching "<%= searchTerm %>" was found.</p>

                    <% } else { %>

                        <h4>No Receptionists Yet</h4>
                        <p>Click "Add Receptionist" above to create the first account.</p>

                    <% } %>

                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="dashboard-table">

                        <thead>

                            <tr>

                                <th>Receptionist</th>
                                <th>Contact</th>
                                <th>Joined</th>
                                <th>Status</th>
                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% receptionists.forEach(function(r) { %>

                                <tr>

                                    <td>

                                        <div class="receptionist-photo-cell">

                                            <img src="<%= r.profile_image ? r.profile_image : '/images/default-user.png' %>"
                                                 alt="<%= r.full_name %>">

                                            <span><%= r.full_name %></span>

                                        </div>

                                    </td>

                                    <td>
                                        <%= r.email %><br>
                                        <small class="text-muted"><%= r.phone %></small>
                                    </td>

                                    <td>
                                        <%= new Date(r.created_at).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    </td>

                                    <td>
                                        <span class="status-badge <%= r.status %>"><%= r.status %></span>
                                    </td>

                                    <td>

                                        <div class="table-actions-group">

                                            <a href="/admin/manageReceptionists/edit/<%= r.user_id %>" class="table-action-btn edit-btn">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>

                                            <form action="/admin/manageReceptionists/toggleStatus/<%= r.user_id %>" method="POST"
                                                  onsubmit="return confirm('<%= r.status === "Active" ? "Deactivate" : "Activate" %> <%= r.full_name %>?');">

                                                <button type="submit" class="table-action-btn <%= r.status === 'Active' ? 'deactivate-btn' : 'activate-btn' %>">
                                                    <i class="bi bi-<%= r.status === 'Active' ? 'slash-circle' : 'check-circle' %>"></i>
                                                    <%= r.status === 'Active' ? 'Deactivate' : 'Activate' %>
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Sidebar Toggle -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle) {

        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });

    }

});

</script>

<!-- Toggle Add Form + Generate Password -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const toggleBtn = document.getElementById("toggleAddBtn");
    const addSection = document.getElementById("addReceptionistSection");

    toggleBtn.addEventListener("click", function () {

        const isHidden = addSection.style.display === "none";
        addSection.style.display = isHidden ? "block" : "none";

        if (isHidden) {
            addSection.scrollIntoView({ behavior: "smooth", block: "start" });
        }

    });

    const generateBtn = document.getElementById("generatePasswordBtn");
    const passwordField = document.getElementById("passwordField");
    const confirmPasswordField = document.getElementById("confirmPasswordField");

    generateBtn.addEventListener("click", function () {

        const chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789";
        let generated = "";

        for (let i = 0; i < 8; i++) {
            generated += chars.charAt(Math.floor(Math.random() * chars.length));
        }

        passwordField.value = generated;
        confirmPasswordField.value = generated;

    });

});

</script>

</body>

</html>
