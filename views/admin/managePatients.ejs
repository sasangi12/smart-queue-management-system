<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Manage Patients | MediQ</title>

    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS (shared theme) -->

    <link rel="stylesheet"
          href="/css/adminDashboard.css">

    <!-- Manage Doctors CSS (reused for generic table/button/
         status-badge classes) -->

    <link rel="stylesheet"
          href="/css/adminManageDoctors.css">

    <!-- Manage Patients CSS -->

    <link rel="stylesheet"
          href="/css/adminManagePatients.css">

</head>

<body>

<!-- ===========================================
        SIDEBAR
=========================================== -->

<%- include('../partials/adminSidebar') %>

<!-- ===========================================
        MAIN CONTENT
=========================================== -->

<div class="main-content">

    <!-- Navbar -->

    <%- include('../partials/adminNavbar') %>

    <!-- Page Content -->

    <div class="dashboard-content">

        <div class="section-header">

            <div>

                <h3 class="section-title mb-1">Manage Patients</h3>
                <p class="section-subtitle">View and oversee every registered patient.</p>

            </div>

        </div>

        <% if (successMsg) { %>

            <div class="booking-alert success" style="padding:16px 20px; border-radius:14px; background:#dcfce7; color:#15803d; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                <i class="bi bi-check-circle-fill"></i>
                <span><%= successMsg %></span>
            </div>

        <% } %>

        <% if (errorMsg) { %>

            <div class="booking-alert error" style="padding:16px 20px; border-radius:14px; background:#fee2e2; color:#dc2626; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span><%= errorMsg %></span>
            </div>

        <% } %>

        <!-- =====================================
                Search
        ====================================== -->

        <div class="patient-search-bar">

            <form action="/admin/managePatients" method="GET">

                <input type="text"
                       name="search"
                       placeholder="Search by name, phone, email, or NIC..."
                       value="<%= searchTerm %>">

                <button type="submit">
                    <i class="bi bi-search me-1"></i>Search
                </button>

                <% if (searchTerm) { %>

                    <a href="/admin/managePatients" class="clear-search-link">
                        Clear
                    </a>

                <% } %>

            </form>

        </div>

        <!-- =====================================
                Patients Table
        ====================================== -->

        <div class="content-card">

            <% if (patients.length === 0) { %>

                <div class="empty-state">

                    <i class="bi bi-person-x"></i>

                    <% if (searchTerm) { %>

                        <h4>No Matches Found</h4>
                        <p>No patient matching "<%= searchTerm %>" was found.</p>

                    <% } else { %>

                        <h4>No Patients Registered Yet</h4>
                        <p>Patients will appear here as they register.</p>

                    <% } %>

                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="dashboard-table">

                        <thead>

                            <tr>

                                <th>Patient</th>
                                <th>Contact</th>
                                <th>NIC</th>
                                <th>Total Visits</th>
                                <th>Status</th>
                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% patients.forEach(function(p) { %>

                                <tr>

                                    <td>

                                        <div class="patient-photo-cell">

                                            <img src="<%= p.profile_image ? p.profile_image : '/images/default-user.png' %>"
                                                 alt="<%= p.full_name %>">

                                            <span><%= p.full_name %></span>

                                        </div>

                                    </td>

                                    <td>
                                        <%= p.email %><br>
                                        <small class="text-muted"><%= p.phone %></small>
                                    </td>

                                    <td><%= p.nic || '—' %></td>

                                    <td>
                                        <span class="visit-count-badge">
                                            <%= p.total_visits %> visit<%= p.total_visits !== 1 ? 's' : '' %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="status-badge <%= p.status %>"><%= p.status %></span>
                                    </td>

                                    <td>

                                        <div class="table-actions-group">

                                            <a href="/admin/managePatients/<%= p.patient_id %>" class="table-action-btn edit-btn">
                                                <i class="bi bi-eye"></i> View
                                            </a>

                                            <form action="/admin/managePatients/toggleStatus/<%= p.patient_id %>" method="POST"
                                                  onsubmit="return confirm('<%= p.status === "Active" ? "Deactivate" : "Activate" %> <%= p.full_name %>?');">

                                                <button type="submit" class="table-action-btn <%= p.status === 'Active' ? 'deactivate-btn' : 'activate-btn' %>">
                                                    <i class="bi bi-<%= p.status === 'Active' ? 'slash-circle' : 'check-circle' %>"></i>
                                                    <%= p.status === 'Active' ? 'Deactivate' : 'Activate' %>
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

</div>

<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Sidebar Toggle -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle) {

        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });

    }

});

</script>

</body>

</html>
