<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notifications | MediQ</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/<%= dashboardCss %>">
    <link rel="stylesheet" href="/css/notifications.css">
</head>

<body>

<%- include(sidebarPath) %>

<div class="main-content">
    <%- include(navbarPath) %>

    <div class="dashboard-content">

        <div class="section-header">
            <div>
                <h3 class="section-title mb-1">Notifications</h3>
                <p class="section-subtitle">Stay updated on appointments, queue activity, and important system updates.</p>
            </div>

            <% if (notifications.length > 0) { %>
                <form action="/<%= rolePrefix %>/notifications/markAllRead" method="POST">
                    <button type="submit" class="primary-btn" style="border:none; cursor:pointer;">
                        <i class="bi bi-check2-all me-1"></i>
                        Mark All as Read
                    </button>
                </form>
            <% } %>
        </div>

        <% if (errorMsg) { %>
            <div class="booking-alert error" style="padding:16px 20px; border-radius:14px; background:#fee2e2; color:#dc2626; margin-bottom:25px; display:flex; align-items:center; gap:12px;">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span><%= errorMsg %></span>
            </div>
        <% } %>

        <div class="content-card">

            <% if (notifications.length === 0) { %>
                <div class="empty-state">
                    <i class="bi bi-bell-slash"></i>
                    <h4>No Notifications</h4>
                    <p>You're all caught up! New updates about your appointments and queue will appear here.</p>
                </div>
            <% } else { %>

                <div class="notification-panel">

                    <% notifications.forEach(function(n) { %>
                        <%
                            const isUnread = n.is_read === 'No';
                            let iconClass = 'bi-bell-fill';
                            let typeClass = 'system';
                            const type = (n.notification_type || '').toLowerCase();

                            if (type.includes('appointment')) {
                                iconClass = 'bi-calendar-check-fill';
                                typeClass = 'appointment';
                            } else if (type.includes('queue')) {
                                iconClass = 'bi-people-fill';
                                typeClass = 'queue';
                            } else if (type.includes('cancel')) {
                                iconClass = 'bi-x-circle-fill';
                                typeClass = 'cancellation';
                            }

                            const sentDate = new Date(n.sent_date);
                        %>

                        <div class="notification-item <%= isUnread ? 'unread' : '' %>" data-id="<%= n.notification_id %>">

                            <% if (isUnread) { %>
                                <span class="unread-dot"></span>
                            <% } %>

                            <div class="notification-icon">
                                <i class="bi <%= iconClass %> notif-type-icon <%= typeClass %>"></i>
                            </div>

                            <div class="notification-content" style="flex:1;">
                                <h5><%= n.title || 'Notification' %></h5>
                                <p><%= n.message || '' %></p>

                                <small>
                                    <%= sentDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    &middot;
                                    <%= sentDate.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                                </small>

                                <div class="notification-actions">
                                    <% if (isUnread) { %>
                                        <button type="button" class="notif-action-btn markReadBtn" data-id="<%= n.notification_id %>">
                                            <i class="bi bi-check2"></i> Mark as Read
                                        </button>
                                    <% } %>

                                    <form action="/<%= rolePrefix %>/notifications/delete/<%= n.notification_id %>" method="POST" style="display:inline;">
                                        <button type="submit" class="notif-action-btn delete-btn">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </div>

                        </div>
                    <% }); %>

                </div>

            <% } %>

        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const menuToggle = document.querySelector(".menu-toggle");
    const sidebar = document.querySelector(".sidebar");

    if (menuToggle && sidebar) {
        menuToggle.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });
    }

    document.querySelectorAll(".markReadBtn").forEach(function (btn) {

        btn.addEventListener("click", function () {

            const notificationId = btn.getAttribute("data-id");
            const card = btn.closest(".notification-item");

            fetch("/<%= rolePrefix %>/notifications/markRead/" + notificationId, {
                method: "POST",
                headers: { "Content-Type": "application/json" }
            })
                .then((res) => res.json())
                .then((data) => {
                    if (data.success) {
                        card.classList.remove("unread");
                        const dot = card.querySelector(".unread-dot");
                        if (dot) dot.remove();
                        btn.remove();
                    }
                })
                .catch(function () {
                    // Keep the notification visible if the request fails.
                });
        });

    });

});
</script>

</body>
</html>
